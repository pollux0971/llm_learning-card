{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='scripts/llm-spend.test.ts' npx vitest run --bail=1 --config vitest.mutate.config.ts -t '^(?!.*整份)'"
  },
  "reporters": ["clear-text", "progress-append-only"],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 300000,
  "mutate": ["scripts/llm-spend.ts"],
  "thresholds": { "high": 90, "low": 70, "break": 0 },
  "ignorePatterns": ["reports", "dist", "target", "apps/desktop/src-tauri"]
}
