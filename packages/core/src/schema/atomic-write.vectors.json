        "target_bytes": "OLD",
        "absent": ["reviews.json.tmp"]
      }
    },
    {
      "name": "rename-and-cleanup-both-fail",
      "setup": {
        "target": "reviews.json",
        "content": "X",
        "prior_target": "OLD",
        "extra_files": []
      },
      "inject": [
        { "call": "rename", "nth": 1, "code": "EXDEV" },
