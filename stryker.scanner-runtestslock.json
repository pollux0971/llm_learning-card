{
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["clear-text", "progress-append-only"],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 90000,
  "vitest": { "configFile": "vitest.scanner-runtestslock.config.ts", "related": false },
  "mutate": ["scripts/run-tests.ts", "!scripts/run-tests.test.ts"],
  "thresholds": { "high": 90, "low": 70, "break": 0 },
  "ignorePatterns": ["reports", "dist", "target", "apps/desktop/src-tauri"]
}
