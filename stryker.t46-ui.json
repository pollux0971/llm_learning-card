{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{packages/ui-shared/src/image-path.test.ts,packages/ui-shared/src/example-fence.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": ["packages/ui-shared/src/example-fence.ts", "packages/ui-shared/src/image-path.ts"],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "ignorePatterns": ["reports", "dist", "apps/desktop/src-tauri/target"]
}
