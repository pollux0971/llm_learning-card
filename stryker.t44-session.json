{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{apps/teach-card/src/teach-session.test.ts,apps/teach-card/src/t40-busy.test.ts,apps/teach-card/src/t43-deepen.test.ts,apps/teach-card/src/t44-generating-session.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": ["apps/teach-card/src/teach-session.ts"],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "ignorePatterns": ["reports", "dist", "apps/desktop/src-tauri/target"]
}
