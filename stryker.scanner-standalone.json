{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --bail=1 --config vitest.scanner-standalone.config.ts"
  },
  "reporters": [
    "clear-text",
    "progress-append-only"
  ],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 60000,
  "mutate": [
    "scripts/check-standalone.ts:22-25",
    "scripts/check-standalone.ts:32-59"
  ],
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 0
  },
  "ignorePatterns": [
    "reports",
    "dist",
    "target",
    "apps/desktop/src-tauri"
  ]
}