{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --bail=1 --config vitest.user-facing-review.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only"],
  "coverageAnalysis": "off",
  "concurrency": 4,
  "timeoutMS": 120000,
  "mutate": [
    "scripts/review.ts:89-95",
    "scripts/review.ts:98-110",
    "packages/core/src/session/summary.ts:75-91",
    "packages/core/src/session/io.ts:102-116"
  ],
  "thresholds": { "high": 90, "low": 70, "break": 0 },
  "ignorePatterns": ["reports", "dist", "target", "apps/desktop/src-tauri"]
}
