{
  "cucumberCwd": ".",
  "chain": [
    "boundaries",
    "check:env-keys",
    "typecheck",
    "lint:docs",
    "test",
    "accept:standalone",
    "standalone",
    "accept:dry",
    "check:dry-run",
    "check:steps",
    "check:gherkin-dup",
    "check:module-cast",
    "accept:coverage",
    "check:gates",
    "check:doc-rot",
    "check:next-gates",
    "check:phase-status"
  ],
  "dryRun": {
    "tags": "@standalone and not @manual"
  },
  "skipDirs": ["tmp-learning"],
  "nextGates": {
    "mode": "enforce"
  },
  "docRot": {
    "mode": "report"
  },
  "unwired": [
    {
      "file": "check-known-defects.ts",
      "reason": "尚未使用 @known-defect tag"
    }
  ],
  "phaseStatus": {
    "mode": "report"
  }
}
