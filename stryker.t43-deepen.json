{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{features/support/t43-handler.test.ts,features/support/t43-commit.test.ts,features/support/t43-cancel.test.ts,features/support/t43-deck.test.ts,features/support/t43-atomic.test.ts,packages/core/src/ingest/generate-cards.test.ts,packages/core/src/ingest/generate-cards.regenerate.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": [
    "packages/core/src/ingest/deepen.ts",
    "packages/core/src/session/teach-deepen.ts",
    "packages/core/src/ingest/generate-cards.ts:81-111",
    "packages/core/src/ingest/generate-cards.ts:147-158"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "ignorePatterns": ["reports", "dist", "apps/desktop/src-tauri/target"]
}
