{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{scripts/dag.test.ts,scripts/dag-check.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": ["scripts/dag.ts:663-1258"],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "ignorePatterns": ["reports", "dist", "target", "apps/desktop/src-tauri"]
}
