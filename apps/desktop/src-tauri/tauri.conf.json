{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "learning-cards-desktop",
  "version": "0.0.0",
  "identifier": "dev.learningcards.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "npm run build:frontends",
      "wait": true
    },
    "beforeBuildCommand": "npm run build:frontends"
  },
  "app": {
    "windows": [
      {
        "label": "teach",
        "title": "LLM Cards — Teach",
        "url": "teach/index.html",
        "width": 360,
        "height": 480,
        "x": 100,
        "y": 100,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "create": false
      },
      {
        "label": "test",
        "title": "LLM Cards — Test",
        "url": "test/index.html",
        "width": 360,
        "height": 480,
        "x": 520,
        "y": 100,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; img-src 'self' lc: data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
