{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "learning-cards-desktop",
  "version": "0.0.0",
  "identifier": "dev.learningcards.desktop",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "teach",
        "title": "LLM Cards — Teach",
        "url": "teach.html",
        "width": 360,
        "height": 480,
        "x": 100,
        "y": 100,
        "resizable": true,
        "visible": true
      },
      {
        "label": "test",
        "title": "LLM Cards — Test",
        "url": "test.html",
        "width": 360,
        "height": 480,
        "x": 520,
        "y": 100,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
