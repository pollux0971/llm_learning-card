{
  "name": "learning-cards",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx scripts/run-tests.ts --",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "accept": "NODE_OPTIONS=--import=tsx cucumber-js",
    "accept:standalone": "NODE_OPTIONS=--import=tsx cucumber-js --tags '@standalone and not @manual'",
    "accept:integration": "NODE_OPTIONS=--import=tsx cucumber-js docs/integration --tags 'not @manual'",
    "mutate": "tsx scripts/mutate.ts --",
    "lint:wiki": "tsx scripts/lint.ts --dir learning",
    "lint:docs": "tsx scripts/check-doc-links.ts",
    "standalone": "tsx scripts/check-standalone.ts",
    "check:steps": "tsx scripts/check-step-dup.ts",
    "check:gherkin-dup": "tsx scripts/check-gherkin-dup.ts",
    "accept:coverage": "tsx scripts/check-phase-coverage.ts",
    "check:gates": "\"${TEMPLATE_DIR:-.claude/worktrees/agent-a551c3d51889a2793/template}/scripts/sync-gates.sh\" \"$(git rev-parse --show-toplevel)\" scripts --check",
    "check:all": "tsx scripts/check-all.ts",
    "check:doc-rot": "tsx scripts/check-doc-rot.ts",
    "check:next-gates": "tsx scripts/check-next-gates.ts",
    "check:known-defects": "tsx scripts/check-known-defects.ts",
    "boundaries": "tsx scripts/check-boundaries.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "prompt:golden": "tsx scripts/prompt-check.ts --golden",
    "tauri": "npm run tauri -w apps/desktop --",
    "accept:dry": "NODE_OPTIONS=--import=tsx cucumber-js --tags 'not @manual' --dry-run",
    "witness:degraded": "tsx scripts/degraded-report.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "svelte": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@tauri-apps/api": "^2.11.1",
    "date-fns": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.1",
    "openai": "^7.9.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
