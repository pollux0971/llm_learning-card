{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{packages/core/src/ingest/card-file.test.ts,packages/core/src/ingest/t58-card-fence-wiring.test.ts,packages/core/src/ingest/children.test.ts,packages/core/src/ingest/ingest.test.ts,packages/core/src/ingest/deps.test.ts,features/support/t58-card-file-guards.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": [
    "packages/core/src/ingest/card-file.ts"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "ignorePatterns": ["reports", "dist", "apps/desktop/src-tauri/target"]
}
