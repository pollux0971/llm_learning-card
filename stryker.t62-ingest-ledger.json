{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{packages/core/src/ingest/t62-budget-exhausted.test.ts,packages/core/src/ingest/t61-bad-model-output.test.ts,packages/core/src/ingest/ingest.test.ts,packages/core/src/ingest/ingest.regenerate.test.ts,packages/core/src/ingest/t53-scan-extra.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": [
    "packages/core/src/ingest/ingest.ts:84-100",
    "packages/core/src/ingest/ingest.ts:195-205"
  ],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "ignorePatterns": ["reports", "dist", "apps/desktop/src-tauri/target"]
}
