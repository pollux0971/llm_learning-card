{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{packages/core/src/llm/routing.test.ts,packages/core/src/llm/router.test.ts,packages/core/src/llm/router-gateway.test.ts,packages/core/src/llm/router-impl.test.ts,packages/core/src/llm/fallback.test.ts,packages/core/src/llm/token-limits.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": ["packages/core/src/llm/routing.ts"],
  "thresholds": { "high": 95, "low": 90, "break": 0 },
  "ignorePatterns": ["reports", "dist", "apps/desktop/src-tauri/target"]
}
