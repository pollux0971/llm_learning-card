# 複製成 .env(已被 .gitignore 擋住)。契約 §11:LLM_* 三個變數覆蓋 config/settings.yaml 的 llm 區段。

# 雲端(ADR-034):生成卡片、考題、依賴圖只走這裡
OPENAI_API_KEY=
LLM_CLOUD_PROVIDER=openai
LLM_CLOUD_MODEL=gpt-5.6-luna

# 本機模型閘道(ADR-039):跑在另一台機器上的 Ollama,透過 JWT 閘道存取。
# 填空審核一律走它;應用審核/深入/縮短版在 OpenAI 失敗或當日預算用完時走它(provisional)。
GATEWAY_BASE_URL=http://localhost:8787
GATEWAY_API_KEY=
LLM_LOCAL_MODEL=qwen2.5:32b

# 當日 OpenAI 花費上限(美元),超過就只走閘道(ADR-039)。價格用來把 tokens 換算成錢,依實際方案填。
LLM_DAILY_CAP_USD=1
LLM_PRICE_IN_PER_M=2.5
LLM_PRICE_OUT_PER_M=10
