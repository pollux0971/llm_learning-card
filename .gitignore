node_modules/
dist/
target/
# reports/ 大多是產物(Stryker 的 html),只有退化路徑報告(ADR-044)要進 git:
# 那是基準數字,之後「未標記數只准降」要拿它比。.raw/ 是跑一次 vitest 的 JSONL,不留。
reports/*
!reports/degraded/
reports/degraded/.raw/
.stryker-tmp/
# 跨 worktree 的 Stryker 鎖(P-29)。放在主 repo 的根,不然各 worktree 看不到彼此。
.stryker.lock
.env
.env.*
*.log
.DS_Store
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/
tmp-learning/
# 使用者的學習資料(卡片、考題、state 的複習歷史)。契約 §11b:learning/ 自己是一個 git repo,
# 主 repo 不追蹤它。learning-*/ 擋掉之後多類別的測試輸出目錄。
learning/
learning-*/
!.env.example

# 12-prompt-quality:fake 模式的 golden run 只是重播 fixture,沒有品質資訊,不進 git(golden/ 的 live run 才進)
packages/core/src/prompt-quality/golden-fake/
# lint 對 fixture 跑「單獨執行」驗證時會在那裡寫報告檔,不要進版本控制
contracts/fixtures/**/state/lint-report-*.md
