{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "MUTATE_TEST_GLOB='{features/support/t37-handler.test.ts,features/support/t37-conflict.test.ts,features/support/t37-gaps.test.ts,packages/core/src/teach/deck.test.ts}' npx vitest run --bail=1 --config vitest.mutate.config.ts"
  },
  "reporters": ["clear-text", "progress-append-only", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 120000,
  "mutate": ["packages/core/src/session/teach.ts", "packages/core/src/teach/deck.ts", "packages/core/src/schema/graph.ts:82-92"],
  "thresholds": { "high": 90, "low": 80, "break": 0 },
  "ignorePatterns": ["reports", "dist", "target", "apps/desktop/src-tauri"]
}
